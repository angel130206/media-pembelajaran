# Database - Supabase Free (tanpa kartu) atau lokal
# Contoh Supabase (pooling, 500MB free): postgresql://postgres.PROJECT:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Atau lokal Docker: postgresql://postgres:postgres@localhost:5432/samarinda_lms
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/samarinda_lms

# Auth - wajib
AUTH_SECRET=your-random-secret-min-32-chars-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=admin@samarinda.id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI - pilih salah satu (prioritas: GROQ > GEMINI). Gratis tanpa kartu.
# Groq Free: 30 RPM / 1.000 RPD per model, tanpa kartu. Daftar di console.groq.com
GROQ_API_KEY=
# Opsional: GROQ_MODEL=llama-3.1-8b-instant  (default) atau llama-3.3-70b-versatile, openai/gpt-oss-120b
GROQ_MODEL=llama-3.1-8b-instant

# Alternatif Gemini (Google AI Studio, tanpa kartu, Flash/Flash-Lite only, quota per-project di AI Studio)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Penyimpanan file - pilih salah satu, hanya yang dipakai yang wajib diisi:
# Opsi 1: Supabase Storage Free (1GB, tanpa kartu) - direkomendasikan untuk Vercel Free
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Opsi 2: S3-compatible (MinIO lokal untuk Docker/VPS, atau S3/R2 jika punya kartu)
# Untuk VPS/Docker lokal, ini sudah terisi default MinIO. Untuk Vercel + Supabase, kosongkan saja.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=samarinda-lms
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_PUBLIC_URL=http://localhost:9000/samarinda-lms
